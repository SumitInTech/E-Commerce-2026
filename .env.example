# ==============================================================================
# SNITCH LUXE AI E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running the project:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows Command Prompt)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="Snitch Luxe AI E-Commerce Platform"
VERSION="2.5.0"
API_V1_STR="/api/v1"
DEBUG=False

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate a secure 32+ character random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="snitch-super-secure-production-secret-key-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours (60 * 24)

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (Default): SQLite database file stored in the root folder.
# The repository already includes a seeded 'ecommerce.db' with default users,
# categories, garments, and multi-point anatomical size charts.
DATABASE_URL="sqlite:///./ecommerce.db"

# Cloud Database (Optional - Supabase / Managed PostgreSQL):
# If SUPABASE_DB_URL is set, the system automatically switches to connection-pooled
# PostgreSQL with pool_pre_ping enabled for production high availability.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Example Supabase URI:
# SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. MICROSERVICES NETWORKING PORTS
# ------------------------------------------------------------------------------
# The unified API Gateway runs on port 8000 and orchestrates all microservices.
# Alternatively, each microservice can be launched autonomously on its own port.
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_PAYMENT=8002
PORT_CATALOG=8003
PORT_ORDER=8004
PORT_ADMIN=8005
PORT_AI_FIT=8006
PORT_CHATBOT=8007

# ------------------------------------------------------------------------------
# 5. GATEWAY RATE LIMITING & SECURITY PERIMETER
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=120
ENABLE_SECURITY_SANITIZER=True
# CORS Origins: Comma-separated or JSON list of allowed origins.
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS & TRANSACTION SIMULATION
# ------------------------------------------------------------------------------
# When PAYMENT_SIMULATION_MODE=True, the system simulates instant credit card,
# UPI, and COD payment settlements with UUIDv4 idempotency deduplication.
PAYMENT_SIMULATION_MODE=True
STRIPE_WEBHOOK_SECRET="whsec_mock_production_webhook_secret"

# Production Payment Gateways (Optional for live transactions):
# STRIPE_SECRET_KEY="sk_test_51..."
# STRIPE_PUBLISHABLE_KEY="pk_test_51..."
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="your_razorpay_secret"

# ------------------------------------------------------------------------------
# 7. AI & GENERATIVE LLM SETTINGS (MODEL 4 - RAG CHATBOT)
# ------------------------------------------------------------------------------
# Google Gemini API Key for semantic customer service & size advisory.
# If left empty (""), the system automatically activates a resilient deterministic
# offline fallback using the store's local knowledge base documents without crashing.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 8. FRONTEND ENVIRONMENT (NEXT.JS)
# ------------------------------------------------------------------------------
# Base URL consumed by the Next.js frontend client (frontend/src/app/page.js)
NEXT_PUBLIC_API_BASE="http://127.0.0.1:8000/api/v1"
